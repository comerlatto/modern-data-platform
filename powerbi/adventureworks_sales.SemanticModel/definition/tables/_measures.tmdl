	measure 'Ranking de Vendedor por Vendas' =

			VAR VendedorAtual =
			    SELECTEDVALUE (
			        'analytics dim_sales_person'[full_name]
			    )
			RETURN
			    IF (
			        ISINSCOPE (
			            'analytics dim_sales_person'[full_name]
			        )
			            && NOT ISBLANK ( VendedorAtual ),
			        RANKX (
			            FILTER (
			                ALLSELECTED (
			                    'analytics dim_sales_person'[full_name]
			                ),
			                NOT ISBLANK (
			                    'analytics dim_sales_person'[full_name]
			                )
			            ),
			            [Vendas Líquidas],
			            ,
			            DESC,
			            DENSE
			        )
			    )
