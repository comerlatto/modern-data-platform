	measure 'Vendas Líquidas Ano Anterior' =

			CALCULATE (
			    [Vendas Líquidas],
			    SAMEPERIODLASTYEAR ( 'analytics dim_date'[full_date] )
			)
		lineageTag: 66a66e62-5226-4276-acbd-c353ef70818d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Crescimento de Vendas YoY' =

			VAR VendasAtuais = [Vendas Líquidas]
			VAR VendasAnoAnterior = [Vendas Líquidas Ano Anterior]
			RETURN
			    IF (
			        NOT ISBLANK ( VendasAtuais )
			            && NOT ISBLANK ( VendasAnoAnterior ),
			        DIVIDE (
			            VendasAtuais - VendasAnoAnterior,
			            VendasAnoAnterior
			        )
			    )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a4f6aa32-3c03-4abf-a824-6451eea0328f

	measure 'Variação de Vendas YoY' =

			VAR VendasAtuais = [Vendas Líquidas]
			VAR VendasAnoAnterior = [Vendas Líquidas Ano Anterior]
			RETURN
			    IF (
			        NOT ISBLANK ( VendasAtuais )
			            && NOT ISBLANK ( VendasAnoAnterior ),
			        VendasAtuais - VendasAnoAnterior
			    )
		lineageTag: db84a903-6c6d-4fae-837f-b8627f284e1b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

