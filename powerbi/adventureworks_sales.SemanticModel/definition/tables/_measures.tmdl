	measure 'Clientes Recorrentes' =

			COUNTROWS (
			    FILTER (
			        VALUES ( 'analytics dim_customer'[customer_id] ),
			        CALCULATE ( [Total de Pedidos] ) > 1
			    )
			)
		formatString: #,0
		lineageTag: f3b356c5-9f6e-4796-a054-ab91a77ac794

	measure 'Taxa de Clientes Recorrentes' =

