	measure 'Crescimento de Vendas YTD YoY' =

			VAR VendasYTD = [Vendas Líquidas YTD]
			VAR VendasYTDAnoAnterior = [Vendas Líquidas YTD Ano Anterior]
			RETURN
			    IF (
			        NOT ISBLANK ( VendasYTD )
