	measure 'Ranking de Produto por Vendas' =

			IF (
			    ISINSCOPE ( 'analytics dim_product'[product_name] ),
			    RANKX (
			        ALLSELECTED ( 'analytics dim_product'[product_name] ),
			        [Vendas Líquidas],
			        ,
			        DESC,
			        DENSE
			    )
			)
		formatString: 0
		lineageTag: 71287dec-d8b3-4542-b103-003189cc5660

	measure 'Produto Top 10' =

			IF (
			    [Ranking de Produto por Vendas] <= 10,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 0cacf12d-5cf1-4aee-b7a6-ded94a934460

	measure 'Vendas dos Produtos Top 10' =

			VAR ProdutosTop10 =
			    TOPN (
			        10,
			        ALLSELECTED ( 'analytics dim_product'[product_name] ),
			        [Vendas Líquidas],
			        DESC
			    )
			RETURN
			    CALCULATE (
			        [Vendas Líquidas],
			        KEEPFILTERS ( ProdutosTop10 )
			    )
		lineageTag: ef636a28-7d0b-4b86-93a8-523e6fe219fe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

