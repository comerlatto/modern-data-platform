	measure 'Vendas Líquidas Mês Anterior' =

			CALCULATE (
			    [Vendas Líquidas],
			    DATEADD (
			        'analytics dim_date'[full_date],
			        -1,
			        MONTH
			    )
			)
		lineageTag: c1351a29-3dde-4a9e-b8a2-16634a9fbc5c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Crescimento de Vendas MoM' =

			VAR VendasAtuais = [Vendas Líquidas]
			VAR VendasMesAnterior = [Vendas Líquidas Mês Anterior]
			RETURN
			    IF (
			        ISINSCOPE ( 'analytics dim_date'[month_name] )
			            && NOT ISBLANK ( VendasAtuais )
			            && NOT ISBLANK ( VendasMesAnterior ),
			        DIVIDE (
			            VendasAtuais - VendasMesAnterior,
			            VendasMesAnterior
			        )
			    )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 40d7df59-2136-44b9-9164-b71a592becd7

	measure 'Variação de Vendas MoM' =

			VAR VendasAtuais = [Vendas Líquidas]
			VAR VendasMesAnterior = [Vendas Líquidas Mês Anterior]
			RETURN
			    IF (
			        ISINSCOPE ( 'analytics dim_date'[month_name] )
			            && NOT ISBLANK ( VendasAtuais )
			            && NOT ISBLANK ( VendasMesAnterior ),
			        VendasAtuais - VendasMesAnterior
			    )
		lineageTag: 94a2d411-d79d-4140-b86c-58d01ab34c11

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Participação nas Vendas do Ano' =

			DIVIDE (
			    [Vendas Líquidas],
			    CALCULATE (
			        [Vendas Líquidas],
			        REMOVEFILTERS (
			            'analytics dim_date'[month_name],
			            'analytics dim_date'[month_number]
			        )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 004cb8bd-4176-41c7-b9f3-c263083701e2

	measure 'Média Móvel de Vendas 3M' =

			VAR DataAtual =
			    MAX ( 'analytics dim_date'[full_date] )

			VAR UltimosTresMeses =
			    DATESINPERIOD (
			        'analytics dim_date'[full_date],
			        DataAtual,
			        -3,
			        MONTH
			    )

			VAR VendasPorMes =
			    CALCULATETABLE (
			        SUMMARIZE (
			            'analytics dim_date',
			            'analytics dim_date'[year_month],
			            "@VendasMes", [Vendas Líquidas]
			        ),
			        REMOVEFILTERS ( 'analytics dim_date' ),
			        UltimosTresMeses
			    )

			RETURN
			    AVERAGEX (
			        FILTER (
			            VendasPorMes,
			            NOT ISBLANK ( [@VendasMes] )
			        ),
			        [@VendasMes]
			    )
		lineageTag: 05544c8a-9507-4af1-89b1-57461ee8e6be

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Produtos Vendidos' =

