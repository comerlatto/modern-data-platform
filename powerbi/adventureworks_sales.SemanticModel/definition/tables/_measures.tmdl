	measure 'Pedidos por Cliente Recorrente' =

			VAR PedidosClientesRecorrentes =
			    SUMX (
			        FILTER (
			            VALUES ( 'analytics dim_customer'[customer_id] ),
			            CALCULATE ( [Total de Pedidos] ) > 1
			        ),
			        CALCULATE ( [Total de Pedidos] )
			    )
			RETURN
			    DIVIDE (
			        PedidosClientesRecorrentes,
			        [Clientes Recorrentes]
			    )
		lineageTag: 7d6c7915-b1cf-4831-a7e0-0b401dd37cff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Vendas de Clientes Recorrentes' =

